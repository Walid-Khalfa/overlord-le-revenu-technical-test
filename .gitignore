# Root safety net — sub-projects carry their own .gitignore

# Dependencies
node_modules/

# Build outputs
frontend/.next/
frontend/out/
backend/dist/
backend/build/
backend/.tmp/
.cache/

# Environment / secrets (never commit)
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*

# Test artifacts (Phase 5)
frontend/test-results/
frontend/playwright-report/

# Manual DB-row backups (Phase 7 cleanup safety net)
backend/tests/backup/

# OS
.DS_Store
