# Strapi v5 — local development template
# Copy to .env and fill in real values. NEVER commit .env.

# Server
HOST=localhost
PORT=1337
APP_KEYS=change-me-1,change-me-2,change-me-3,change-me-4
API_TOKEN_SALT=change-me
ADMIN_JWT_SECRET=change-me
JWT_SECRET=change-me
TRANSFER_TOKEN_SALT=change-me
ENCRYPTION_KEY=change-me

# PostgreSQL (docker-compose.yml at repo root, service: postgres)
DATABASE_CLIENT=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=le_revenu
DATABASE_USERNAME=strapi
DATABASE_PASSWORD=change-me
DATABASE_SSL=false

# Demo data seed (src/utils/seed.ts) — idempotent; creates only what is missing.
# SEED_USER_PASSWORD is a demo-only member password, never a production secret.
SEED_DEMO_DATA=true
SEED_USER_PASSWORD=change-me-demo-password
